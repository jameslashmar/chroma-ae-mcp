<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="12.0"
                   ExtensionBundleId="london.chroma.aemcp"
                   ExtensionBundleVersion="0.1.0"
                   ExtensionBundleName="Chroma AE MCP"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="london.chroma.aemcp" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[25.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="london.chroma.aemcp">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/core.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Chroma AE MCP</Menu>
          <Geometry>
            <Size>
              <Height>240</Height>
              <Width>320</Width>
            </Size>
            <MinSize>
              <Height>140</Height>
              <Width>220</Width>
            </MinSize>
            <MaxSize>
              <Height>900</Height>
              <Width>900</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
